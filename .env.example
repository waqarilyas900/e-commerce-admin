# Point at the same Supabase project as the storefront (Dashboard → Settings → API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sign in with the admin user created by the website seed (same DB as above).
# From e-commerece-website:
#   npm run seed:admin
# Defaults (override with ADMIN_SEED_EMAIL / ADMIN_SEED_PASSWORD):
#   admin@store.com / admin@123
