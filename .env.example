# Copy to `.env`. Same Supabase project as the storefront (Dashboard → Settings → API).

VITE_SUPABASE_URL= # https://<ref>.supabase.co (must match storefront NEXT_PUBLIC_SUPABASE_URL)
VITE_SUPABASE_ANON_KEY= # anon key only — never put service_role here

# Storefront origin (no trailing slash). Used for newsletter send → Next API. Match storefront NEXT_PUBLIC_SITE_URL.
VITE_STOREFRONT_ORIGIN= # Dev: http://localhost:3000 ; prod: https://www.simplecartstore.com (no trailing slash)
# If the admin UI POSTs to the storefront /api/revalidate, set the storefront env REVALIDATE_CORS_ORIGINS
# to this admin origin (e.g. https://admin.example.com,http://localhost:5173).

# First admin user: from e-commerece-website run `npm run seed:admin` (defaults admin@store.com / admin@123 unless env overrides in that project).
